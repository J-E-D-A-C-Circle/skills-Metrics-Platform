# =============================================================================
# .env.example · Copy to ".env" and fill in. Never commit the real .env (it is in .gitignore).
# =============================================================================

# ===== Database (MySQL) =====
# Matches docker-compose.yml. Change the password for anything other than your own machine.
DATABASE_URL="mysql://skm:change-me@localhost:3306/skill_matrix"
MYSQL_ROOT_PASSWORD="change-me-root"
MYSQL_DATABASE="skill_matrix"
MYSQL_USER="skm"
MYSQL_PASSWORD="change-me"
PHPMYADMIN_PORT="8085"

# ===== First administrator (used by npm run db:seed) =====
# A TEMPORARY password: you'll be asked to set your own on first sign-in. Re-running the seed never resets it.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@dvla.gov.gh"
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD="Password123!"

# ===== Test accounts (optional, never in production) =====
# SEED_DEMO=true adds a manager, a creator and participants with staff IDs starting DEMO-.
SEED_DEMO="false"
SEED_DEMO_PASSWORD=""

# ===== Sessions & Cookies =====
SESSION_MAX_HOURS="12"
SESSION_IDLE_MINUTES="60"
# Set to "true" only if running behind HTTPS/SSL. Leave "false" when accessing via HTTP/IP.
COOKIE_SECURE="false"

# ===== Scheduled jobs =====
# Secret for POST /api/jobs/reminders (deadline reminders). At least 16 random characters; leave empty to allow
# only signed-in administrators to run it. Example cron line (hourly):
#   0 * * * * curl -fsS -X POST -H "x-jobs-secret: $JOBS_SECRET" http://localhost:3000/api/jobs/reminders
JOBS_SECRET=""

# ===== File storage =====
# Where support-ticket attachments are kept (default: the "storage" folder in the project, which git ignores).
STORAGE_DIR=""
