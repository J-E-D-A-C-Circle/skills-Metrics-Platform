# =============================================================================
# .gitignore · DVLA Skills Metrics & Vehicle Layoff Suite
# =============================================================================

# Dependencies
node_modules/

# Next.js build outputs
.next/
.next-*/
out/
dist/
build/

# Environment & secrets (keep .env.example)
.env
.env.*
!.env.example

# Generated Prisma client binaries (platform-specific; regenerated on install/build)
lib/prisma-client/
layoff/lib/prisma-client/

# Runtime storage & uploads
storage/
uploads/*
!uploads/.gitkeep
layoff/uploads/*
!layoff/uploads/.gitkeep

# TypeScript & build caches
*.tsbuildinfo
.vercel
.turbo

# Logs & OS files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Local editor / AI agent metadata & scratch files
.agents/
.cursor/
.gemini/
.vscode/
scratch_skill_matrix/
