<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
          xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
          xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides"
          xsi:type="MailApp">

  <!-- Manifest for DVLA Outlook Web App & Desktop Add-in -->
  <Id>60f08967-8ef3-40e1-bbcb-b0e6e76839cf</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Driver and Vehicle Licensing Authority (DVLA)</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="DVLA Tests &amp; Reminders" />
  <Description DefaultValue="Keep track of assigned DVLA tests, synchronize assessment schedules with your Outlook calendar, and receive automated reminders in your DVLA Outlook account (webmail.dvla.gov.gh)." />
  <IconUrl DefaultValue="https://skillmatrix.dvla.gov.gh/outlook/icon-80.png" />
  <HighResolutionIconUrl DefaultValue="https://skillmatrix.dvla.gov.gh/outlook/icon-128.png" />
  <SupportUrl DefaultValue="https://skillmatrix.dvla.gov.gh/outlook" />
  <AppDomains>
    <AppDomain>https://skillmatrix.dvla.gov.gh</AppDomain>
    <AppDomain>https://webmail.dvla.gov.gh</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="MailHost" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://skillmatrix.dvla.gov.gh/outlook/taskpane" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Message Read Ribbon Surface -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="dvlaGroupMessageRead">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="btnDvlaTestsRead">
                  <Label resid="btnLabel" />
                  <Supertip>
                    <Title resid="btnLabel" />
                    <Description resid="btnSuperTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Calendar Organizer Ribbon Surface -->
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="dvlaGroupCalendarOrg">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="btnDvlaTestsOrg">
                  <Label resid="btnLabel" />
                  <Supertip>
                    <Title resid="btnLabel" />
                    <Description resid="btnSuperTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Calendar Attendee Ribbon Surface -->
          <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="dvlaGroupCalendarAtt">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="btnDvlaTestsAtt">
                  <Label resid="btnLabel" />
                  <Supertip>
                    <Title resid="btnLabel" />
                    <Description resid="btnSuperTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://skillmatrix.dvla.gov.gh/outlook/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://skillmatrix.dvla.gov.gh/outlook/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://skillmatrix.dvla.gov.gh/outlook/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://skillmatrix.dvla.gov.gh/outlook/taskpane" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="DVLA Assessments" />
        <bt:String id="btnLabel" DefaultValue="DVLA Tests &amp; Reminders" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="btnSuperTip" DefaultValue="View assigned competency tests, sync test deadlines to your Outlook calendar, and manage deadline reminders." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>

